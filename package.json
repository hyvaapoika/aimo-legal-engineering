{
  "name": "aimo-agent-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n gateway,web 'tsx watch apps/gateway/src/index.ts' 'pnpm --filter @aimo/web dev'",
    "dev:gateway": "tsx watch apps/gateway/src/index.ts",
    "build": "pnpm typecheck && turbo run build",
    "typecheck": "tsc --noEmit && pnpm --filter @aimo/web typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx scripts/demo.ts",
    "demo:food-evidence": "tsx scripts/demo-food-evidence.ts",
    "evidence:import": "tsx scripts/import-food-declaration.ts",
    "ingest": "tsx scripts/ingest.ts",
    "schemas": "tsx scripts/schemas.ts",
    "buyer": "tsx apps/buyer-agent/src/index.ts",
    "buyer:claude": "tsx apps/buyer-agent/src/claude.ts",
    "check": "pnpm typecheck && pnpm test && pnpm demo",
    "format": "prettier --write apps packages scripts tests '*.{json,md}'",
    "start": "concurrently -k -n gateway,web 'tsx apps/gateway/src/index.ts' 'pnpm --filter @aimo/web start'",
    "buyer:review": "tsx apps/buyer-agent/src/review.ts",
    "test:postgres": "tsx scripts/verify-postgres.ts",
    "voice:setup": "tsx scripts/elevenlabs.ts setup",
    "voice:check": "tsx scripts/elevenlabs.ts check",
    "voice:update": "tsx scripts/elevenlabs.ts update",
    "index:search": "tsx scripts/index-discovery.ts",
    "evaluate:search": "tsx scripts/evaluate-discovery-challenge.ts"
  },
  "dependencies": {
    "@aimo/catalog": "workspace:*",
    "@aimo/database": "workspace:*",
    "@aimo/discovery": "workspace:*",
    "@aimo/feasibility": "workspace:*",
    "@aimo/ledger": "workspace:*",
    "@aimo/peppol": "workspace:*",
    "@aimo/rules": "workspace:*",
    "@aimo/schema": "workspace:*",
    "@aimo/signing": "workspace:*",
    "@aimo/valio-client": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "^0.2.0",
    "@electric-sql/pglite": "^0.3.14",
    "@elevenlabs/elevenlabs-js": "^2.78.0",
    "@google/genai": "^1.30.0",
    "@hono/node-server": "^2.1.3",
    "@huggingface/transformers": "4.3.2",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "csv-parse": "^7.0.2",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.0",
    "fast-xml-parser": "^5.3.0",
    "hono": "^4.10.0",
    "jose": "^6.1.0",
    "luxon": "^3.7.0",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.6.0",
    "railway": "^3.17.0",
    "tsx": "^4.20.0",
    "turbo": "^2.6.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  }
}
