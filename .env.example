# Copy to .env. The default demo needs no provider credentials.
MOCK_VALIO=true
VALIO_BASE_URL=https://junction26.valioaimo.fi
VALIO_API_KEY=
PORT=4000
PUBLIC_GATEWAY_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3100
GATEWAY_URL=http://localhost:4000
# Empty uses embedded PostgreSQL in .local/db. Set to use external PostgreSQL.
DATABASE_URL=
STATE_DIR=.local
ALLOW_BEARER=true
# Demo tokens are accepted only in local mock mode. Set strong tokens before hosting.
AGENT_TOKEN=local-buyer-demo
ADMIN_TOKEN=local-admin-demo
DEMO_MODE=true
# Production judge sandbox only: share read/write demo state with public users.
PUBLIC_DEMO_MODE=false
# Route the Railway public port through Hono to the private Next.js server.
PROXY_WEB=false
WEB_PORT=3100
# Optional Ed25519 private JWK; otherwise generated and stored in .local/signing.json.
AIMO_SIGNING_KEY=
VOICE_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
