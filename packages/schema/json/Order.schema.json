{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "proposalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "verdictId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "approvalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "customerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "agentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "qty": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000
          },
          "salesUnit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "offerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "substituteFor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "rationale": {
            "type": "string",
            "maxLength": 500
          },
          "requiredClaims": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "allergenFree": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "name": {
            "type": "string"
          },
          "gtin": {
            "type": "string"
          },
          "unitPrice": {
            "type": "number"
          },
          "lineTotalCents": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "deliveryDate": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        },
        "required": [
          "productId",
          "qty",
          "salesUnit",
          "offerId",
          "requiredClaims",
          "allergenFree",
          "name",
          "unitPrice",
          "lineTotalCents",
          "deliveryDate"
        ],
        "additionalProperties": false
      }
    },
    "totalCents": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "currency": {
      "type": "string",
      "const": "EUR"
    },
    "deliveryDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "deliverySite": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "confirmedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "simulated": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "id",
    "proposalId",
    "verdictId",
    "customerId",
    "agentId",
    "lines",
    "totalCents",
    "currency",
    "deliveryDate",
    "deliverySite",
    "confirmedAt",
    "simulated"
  ],
  "additionalProperties": false
}
