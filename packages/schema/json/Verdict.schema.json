{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "proposalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "result": {
      "type": "string",
      "enum": [
        "AUTO",
        "HOLD",
        "REFUSE"
      ]
    },
    "firedRules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "HOLD",
              "REFUSE"
            ]
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "productId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "observed": {},
          "limit": {}
        },
        "required": [
          "id",
          "severity",
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "perLine": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "result": {
            "type": "string",
            "enum": [
              "AUTO",
              "HOLD",
              "REFUSE"
            ]
          }
        },
        "required": [
          "productId",
          "result"
        ],
        "additionalProperties": false
      }
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "foodEvidence": {
      "type": "object",
      "properties": {
        "ruleId": {
          "type": "string",
          "const": "KITCHEN-EGG-01/v1"
        },
        "origin": {
          "type": "string",
          "const": "kitchen_policy"
        },
        "informationLaw": {
          "type": "string",
          "const": "https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX%3A02011R1169-20250401"
        },
        "mandateVersion": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "declaration": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "productId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "revision": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "documentId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "locator": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      },
                      "issuedAt": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                      },
                      "egg": {
                        "type": "string",
                        "enum": [
                          "declared_free",
                          "contains",
                          "may_contain",
                          "not_stated"
                        ]
                      }
                    },
                    "required": [
                      "productId",
                      "revision",
                      "documentId",
                      "locator",
                      "issuedAt",
                      "egg"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "catalogueFlagsEgg": {
                "type": "boolean"
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "supported",
                  "unknown",
                  "contradicted"
                ]
              }
            },
            "required": [
              "productId",
              "declaration",
              "catalogueFlagsEgg",
              "outcome"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "ruleId",
        "origin",
        "informationLaw",
        "mandateVersion",
        "lines"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "proposalId",
    "result",
    "firedRules",
    "perLine",
    "evaluatedAt"
  ],
  "additionalProperties": false
}
