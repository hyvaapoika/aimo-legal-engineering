{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "limits": {
      "type": "object",
      "properties": {
        "perOrder": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000
        },
        "perWeek": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000
        },
        "currency": {
          "type": "string",
          "const": "EUR"
        }
      },
      "required": [
        "perOrder",
        "perWeek",
        "currency"
      ],
      "additionalProperties": false
    },
    "categories": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "deliverySites": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "substitutionPolicy": {
      "type": "string",
      "enum": [
        "explicit",
        "category",
        "none"
      ]
    },
    "allergenProfile": {
      "type": "string",
      "enum": [
        "strict",
        "standard"
      ]
    },
    "requiredClaims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "allergenFree": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "acceptCatalogPrice": {
      "type": "boolean"
    },
    "approvers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "channels": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "app",
                "sms",
                "voice"
              ]
            }
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+[1-9]\\d{7,14}$"
          },
          "quietHours": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 23
              },
              "end": {
                "type": "integer",
                "minimum": 0,
                "maximum": 23
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "userId",
          "name",
          "channels"
        ],
        "additionalProperties": false
      }
    },
    "validTo": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "version",
    "limits",
    "categories",
    "deliverySites",
    "substitutionPolicy",
    "allergenProfile",
    "requiredClaims",
    "allergenFree",
    "acceptCatalogPrice",
    "approvers",
    "validTo"
  ],
  "additionalProperties": false
}
