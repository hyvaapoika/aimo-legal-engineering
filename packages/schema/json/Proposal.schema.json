{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestedDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "deliverySite": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "lines": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "qty": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000
          },
          "salesUnit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "offerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "substituteFor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "rationale": {
            "type": "string",
            "maxLength": 500
          },
          "requiredClaims": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "allergenFree": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        },
        "required": [
          "productId",
          "qty",
          "salesUnit",
          "offerId",
          "requiredClaims",
          "allergenFree"
        ],
        "additionalProperties": false
      }
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "requirementRef": {
      "type": "string",
      "maxLength": 200
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "agentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "customerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "totalCents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "held",
        "refused",
        "placed",
        "rejected",
        "expired",
        "amended"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "verdict": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "proposalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "result": {
          "type": "string",
          "enum": [
            "AUTO",
            "HOLD",
            "REFUSE"
          ]
        },
        "firedRules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "HOLD",
                  "REFUSE"
                ]
              },
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "productId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "observed": {},
              "limit": {}
            },
            "required": [
              "id",
              "severity",
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "perLine": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "result": {
                "type": "string",
                "enum": [
                  "AUTO",
                  "HOLD",
                  "REFUSE"
                ]
              }
            },
            "required": [
              "productId",
              "result"
            ],
            "additionalProperties": false
          }
        },
        "evaluatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "id",
        "proposalId",
        "result",
        "firedRules",
        "perLine",
        "evaluatedAt"
      ],
      "additionalProperties": false
    },
    "approvalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "orderId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "parentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  },
  "required": [
    "requestedDate",
    "deliverySite",
    "lines",
    "idempotencyKey",
    "id",
    "agentId",
    "customerId",
    "totalCents",
    "status",
    "createdAt",
    "verdict",
    "revision"
  ],
  "additionalProperties": false
}
